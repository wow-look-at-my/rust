# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 5: the dep graph bytes of each dep kind on rustc, from -Zincremental-info.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=f7303973e7a9e3e7c0d51c27013c2c75d3739383
grok_ref=master
workloads=rustc
config=best-size-info patched -Zincremental-rmeta-reuse -Zincremental-uncache=optimized_mir,typeck_root -Zincremental-info
