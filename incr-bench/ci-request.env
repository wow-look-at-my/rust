# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 37: size_estimate by InstanceKind, key-half refs, 1 MiB blocks, no_hash on mono collection, edge and unread stats.
# The tp configs give per-instance dep kinds no node of their own (-Zincremental-transparent).
# A push that changes this file cancels the incr-bench run in progress.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=
grok_ref=master
workloads=grok rustc
config=baseline baseline
config=keep-mir-info patched -Zincremental-rmeta-reuse -Zincremental-uncache=typeck_root -Zincremental-info
config=tp-symbol patched -Zincremental-rmeta-reuse -Zincremental-uncache=typeck_root -Zincremental-info -Zincremental-transparent=symbol_name
config=tp-instance patched -Zincremental-rmeta-reuse -Zincremental-uncache=typeck_root,codegen_select_candidate -Zincremental-info -Zincremental-transparent=symbol_name,resolve_instance_raw,TraitSelect,fn_abi_of_instance_no_deduced_attrs,codegen_select_candidate
