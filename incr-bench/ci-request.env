# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 40: spans that take their context, parent and start from the span before, values with no
# tag, an index of distances, type shorthands as distances, edge counts by kind, cache sections.
# tp-symbol-nomir does not cache optimized_mir. tp-symbol-cheap does not cache queries that HIR
# gives back cheaply. Run 34 holds the baseline of the same baseline commit.
# A push that changes this file cancels the incr-bench run in progress.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=
grok_ref=master
workloads=grok rustc
config=tp-symbol patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root
config=tp-symbol-nomir patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root,optimized_mir
config=tp-symbol-cheap patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root,def_span,def_ident_span,generics_of,type_of,explicit_clauses_of,fn_sig,lookup_stability,lookup_const_stability,codegen_fn_attrs,inferred_outlives_of
