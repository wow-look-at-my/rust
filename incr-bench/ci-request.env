# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=206845ccebc4be8422bdd06ec9146fc860ecf68b
grok_ref=master
workloads=grok syn
config=baseline baseline
config=patched patched
config=patched-inplace patched -Zincremental-inplace-cache
config=patched-uncache-mir patched -Zincremental-uncache=optimized_mir
config=patched-uncache-all patched -Zincremental-uncache=optimized_mir,typeck_root,items_of_instance
config=patched-rmeta patched -Zincremental-rmeta-reuse -Zincremental-info
config=patched-inplace-rmeta patched -Zincremental-inplace-cache -Zincremental-rmeta-reuse -Zincremental-info
config=patched-rmeta-uncache-mir patched -Zincremental-rmeta-reuse -Zincremental-uncache=optimized_mir -Zincremental-info
config=patched-rmeta-uncache-all patched -Zincremental-rmeta-reuse -Zincremental-uncache=optimized_mir,typeck_root,items_of_instance -Zincremental-info
