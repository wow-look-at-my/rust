# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 57: promoted_mir of a body the .rmeta lacks runs mir_borrowck and mir_promoted again, which typeck the body.
# Run 56 profiled 392 such typecks on the grok new-item edit under props-sym-mir. props-sym-mirp caches promoted_mir
# too: the query cache holds it only for the bodies the metadata does not.
# A push that changes this file cancels the incr-bench run in progress.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=
grok_ref=master
workloads=grok rustc
paired=grok:2 rustc:2
config=unpatched baseline -Zincremental-info
config=props-sym-mir patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint -Zincremental-uncache=typeck_root,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,codegen_select_candidate,eval_to_const_value_raw,eval_to_allocation_raw,symbol_name -Zincremental-extern-items
config=props-sym-mirp patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint -Zincremental-uncache=typeck_root,mir_for_ctfe,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,codegen_select_candidate,eval_to_const_value_raw,eval_to_allocation_raw,symbol_name -Zincremental-extern-items
