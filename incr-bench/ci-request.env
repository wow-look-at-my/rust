# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 45: types and signatures come from the previous metadata, and extern_item_fingerprint
# covers more lookups. The baseline is the compiler of run 44, so its nomir-xitems config runs
# beside the new one. A lean config also stops caching local queries that are cheap to rebuild
# or rarely read. A proof config gives the proof-tree query no node, and a select config gives
# TraitSelect none too. A push that changes this file cancels the incr-bench run in progress.
baseline=1a27effd48bee94e62f2ef212568c5476c11c2c3
patched=
grok_ref=master
workloads=grok rustc
config=nomir-xitems-run44 baseline -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root,optimized_mir -Zincremental-extern-items
config=nomir-xitems patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root,optimized_mir -Zincremental-extern-items
config=nomir-xitems-lean patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header -Zincremental-extern-items
config=nomir-xitems-lean-csc patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,codegen_select_candidate -Zincremental-extern-items
config=nomir-xitems-lean-proof patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name,evaluate_root_goal_for_proof_tree_raw -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header -Zincremental-extern-items
config=nomir-xitems-lean-proof-select patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name,evaluate_root_goal_for_proof_tree_raw,TraitSelect -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header -Zincremental-extern-items
