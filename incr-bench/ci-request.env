# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 53: symbol_name is cache_on_disk again, as upstream has it. props-sym keeps its node and leaves its value out of the
# query cache, as props-ctfe-sym of run 52 did. props-symc stores the value too, so a green name loads rather than runs.
# The per-config legs also count the items the metadata decoder rejects, by cause.
# A push that changes this file cancels the incr-bench run in progress.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=
grok_ref=master
workloads=grok rustc
paired=grok:2 rustc:2
config=unpatched baseline -Zincremental-info
config=props-sym patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,codegen_select_candidate,eval_to_const_value_raw,eval_to_allocation_raw,symbol_name -Zincremental-extern-items
config=props-symc patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,codegen_select_candidate,eval_to_const_value_raw,eval_to_allocation_raw -Zincremental-extern-items
