# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 38: config-dir pruning on, local-keyed node stats, and the tp configs after the profiler id fix.
# tp-items gives items_of_instance no node and no cache entry. tp-items-nomir also uncaches optimized_mir.
# Run 34 holds the baseline of the same baseline commit.
# A push that changes this file cancels the incr-bench run in progress.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=
grok_ref=master
workloads=grok rustc
config=keep-mir-info patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-uncache=typeck_root
config=tp-symbol patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-uncache=typeck_root -Zincremental-transparent=symbol_name
config=tp-items patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-uncache=typeck_root,items_of_instance -Zincremental-transparent=symbol_name,items_of_instance
config=tp-items-nomir patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-uncache=typeck_root,items_of_instance,optimized_mir -Zincremental-transparent=symbol_name,items_of_instance
