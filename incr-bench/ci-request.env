# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 11: name the red input behind each codegen unit that compiles again. The signature edit compiles all of the edited crate's units again.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=
grok_ref=master
workloads=grok
config=best-size-explain patched -Zincremental-rmeta-reuse -Zincremental-uncache=optimized_mir,typeck_root -Zincremental-explain-red=CompileCodegenUnit
