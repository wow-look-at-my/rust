# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 39: spans that take their context, parent and start from the span before, values with no
# tag and an index of distances, and edge counts by reader and target kind.
# Run 34 holds the baseline of the same baseline commit. Run 38 rejected tp-items on edit time.
# A push that changes this file cancels the incr-bench run in progress.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=
grok_ref=master
workloads=grok rustc
config=keep-mir-info patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-uncache=typeck_root
config=tp-symbol patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-uncache=typeck_root -Zincremental-transparent=symbol_name
