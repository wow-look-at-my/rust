# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 41: the run 40 encodings plus the smaller values index and def path table.
# The baseline is the compiler of run 38, so tp-symbol-run38 and tp-symbol run on the same
# kind of runner in the same run. tp-symbol-nomir does not cache optimized_mir.
# tp-symbol-cheap does not cache the queries that the flag still accepts and HIR gives back
# cheaply. A fed query is refused.
# A push that changes this file cancels the incr-bench run in progress.
baseline=a0aba3d7df79759363f301865e22ff2fee4852a7
patched=
grok_ref=master
workloads=grok rustc
config=tp-symbol-run38 baseline -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root
config=tp-symbol patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root
config=tp-symbol-nomir patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root,optimized_mir
config=tp-symbol-cheap patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name -Zincremental-uncache=typeck_root,fn_sig,lookup_stability,lookup_const_stability
