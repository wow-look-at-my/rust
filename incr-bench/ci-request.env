# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=e42db7dfbc3aee1bacd744e5a91ab3e37712ae3d
grok_ref=master
workloads=grok syn
config=patched-rmeta-uncache-mir-typeck patched -Zincremental-rmeta-reuse -Zincremental-uncache=optimized_mir,typeck_root -Zincremental-info
config=patched-inplace-rmeta-uncache-mir-typeck patched -Zincremental-inplace-cache -Zincremental-rmeta-reuse -Zincremental-uncache=optimized_mir,typeck_root -Zincremental-info
