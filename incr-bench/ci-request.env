# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=7577b3505e676d0695cf0b0e114bc299d4c61dc3
grok_ref=master
workloads=grok syn
config=baseline baseline
config=patched patched
config=patched-inplace patched -Zincremental-inplace-cache
config=patched-uncache-mir patched -Zincremental-uncache=optimized_mir
config=patched-uncache-all patched -Zincremental-uncache=optimized_mir,typeck_root,items_of_instance
# The toolchain reaches the legs as a run file.
