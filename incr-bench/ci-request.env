# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 62: run 60 put props-sym-mirp-sys at 107% of the rustc object files, with edit times equal to unpatched.
# props-sym-mirp-sys-csc makes codegen_select_candidate transparent: 459k rustc nodes with under 2 edges each.
# props-sym-mirp-sys-csc-ws adds -Zincremental-mir-working-set, so the cache keeps only the MIR a session used.
# A push that changes this file cancels the incr-bench run in progress.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=
grok_ref=master
workloads=grok rustc
paired=grok:2 rustc:2
config=unpatched baseline -Zincremental-info
config=props-sym-mirp-sys-csc patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint,codegen_select_candidate -Zincremental-uncache=typeck_root,mir_for_ctfe,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,eval_to_const_value_raw,eval_to_allocation_raw,symbol_name -Zincremental-extern-items -Zincremental-extern-sysroot
config=props-sym-mirp-sys-csc-ws patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint,codegen_select_candidate -Zincremental-uncache=typeck_root,mir_for_ctfe,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,eval_to_const_value_raw,eval_to_allocation_raw,symbol_name -Zincremental-extern-items -Zincremental-extern-sysroot -Zincremental-mir-working-set
