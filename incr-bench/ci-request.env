# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 48: the patched compiler adds three changes to the compiler of run 46. The query cache writes a
# repeated instance as a distance back. The metadata gives back generics, clauses and codegen attributes.
# The cache leaves out the spans that the metadata holds. The extra configs try an extern is_reachable_non_generic
# without a node, CTFE results out of the cache, and mono item collection with no node and no cache.
# A push that changes this file cancels the incr-bench run in progress.
baseline=9c13c3b3d7c15bbf4ff310ec086ffd0d9bccc028
patched=
grok_ref=master
workloads=grok rustc
config=props-run46 baseline -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name,callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,codegen_select_candidate -Zincremental-extern-items
config=props patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name,callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,codegen_select_candidate -Zincremental-extern-items
config=props-reach patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name,callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint,is_reachable_non_generic -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,codegen_select_candidate -Zincremental-extern-items
config=props-ctfe patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name,callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,codegen_select_candidate,eval_to_const_value_raw,eval_to_allocation_raw -Zincremental-extern-items
config=props-mono patched -Zincremental-rmeta-reuse -Zincremental-info -Zincremental-keep-configs=1 -Zincremental-transparent=symbol_name,callee_facts,is_freeze_raw,is_unpin_raw,is_unsafe_unpin_raw,adt_sizedness_constraint,items_of_instance -Zincremental-uncache=typeck_root,optimized_mir,mir_for_ctfe,promoted_mir,lookup_stability,lookup_deprecation_entry,lookup_const_stability,adt_def,impl_trait_header,codegen_select_candidate,items_of_instance -Zincremental-extern-items
