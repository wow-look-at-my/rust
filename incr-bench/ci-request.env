# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 20: one diagnostic config. On the first decoded body that does not match its hash, -Zincremental-info names the fields that differ from the built body.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=
grok_ref=master
workloads=grok
config=keep-mir-info patched -Zincremental-rmeta-reuse -Zincremental-uncache=typeck_root -Zincremental-info
