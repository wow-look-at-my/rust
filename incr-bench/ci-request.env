# A push that changes this file runs .github/workflows/incr-bench.yml with these inputs.
# baseline and patched are commits or refs of wow-look-at-my/rust. An empty patched means the pushed commit.
# Run 9c: lint passes read effective visibilities per item. The later jobs now receive the bench scripts as a run file, not a checkout. The rustc source checkout fetches one commit and tries again on a refused fetch.
baseline=dc44e7f2c436b6041742e138b9c2176f093196d5
patched=
grok_ref=master
workloads=grok rustc
config=baseline baseline
config=best-size patched -Zincremental-rmeta-reuse -Zincremental-uncache=optimized_mir,typeck_root
config=best-size-info patched -Zincremental-rmeta-reuse -Zincremental-uncache=optimized_mir,typeck_root -Zincremental-info
